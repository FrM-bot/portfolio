---
import SocialLinks from './SocialLinks.astro'
import { convertAsteriskToStrongTag } from '@/utils'
import Link from './ui/Link.astro'
import { getI18n } from '@/i18n'

const { currentLocale } = Astro

const i18n = getI18n({ lang: currentLocale })

const presentation = i18n.Presentation

const greeting = i18n.Presentation.greeting
const status = i18n.Presentation.status
---

<article
  data-intro
  class="col-span-full grid grid-cols-1 items-stretch gap-[clamp(1.5rem,5vw,5rem)] overflow-hidden rounded-panel border border-line bg-surface p-[clamp(1.25rem,3vw,2.25rem)] transition-[border-color,background-color] duration-300 [grid-template-areas:'copy'_'portrait'] phone:min-h-[380px] phone:[grid-template-columns:minmax(0,1fr)_minmax(190px,0.34fr)] phone:[grid-template-areas:'copy_portrait']"
>
  {
    presentation.profile && (
      <div data-intro-item class="flex min-w-0 flex-col items-center justify-center gap-4 [grid-area:portrait]">
        <picture class="block w-full max-w-[15rem] overflow-hidden rounded-2xl border border-line bg-surface-raised max-phone:w-[min(100%,13rem)]">
          <img
            width="180"
            height="180"
            src={presentation.profile}
            alt="GitHub profile"
            class="block aspect-square w-full object-cover [filter:saturate(0.72)_sepia(0.14)]"
          />
        </picture>
        <Link
          variant="rounded"
          href={presentation.curriculum.link}
          target="_blank"
          class="w-fit !border-line-strong !rounded-full !bg-transparent !px-3.5 !py-[0.55rem] !text-[0.65rem] !font-display !font-semibold !tracking-[0.12em] !text-foreground-secondary !uppercase hover:!border-accent hover:!bg-accent hover:!text-accent-ink"
        >
          {presentation.curriculum.label}
        </Link>
      </div>
    )
  }

  <div class="flex min-w-0 flex-col items-start justify-center gap-[clamp(1rem,2vw,1.5rem)] [grid-area:copy]">
    <div class="flex flex-col gap-1">
      <p data-intro-item class="font-editorial text-[clamp(1rem,1.5vw,1.3rem)] font-normal text-accent italic">
        {greeting}
      </p>
      <h1 class="m-0 max-w-[10ch] overflow-hidden font-display text-[clamp(3.8rem,9vw,7.6rem)] leading-[0.86] font-bold tracking-[-0.075em] text-foreground text-wrap-balance">
        <span data-intro-title class="inline-block">{presentation.title}</span>
      </h1>
    </div>

    {
      status && (
        <div data-intro-item class="inline-flex items-center gap-2.5 text-[0.7rem] font-semibold tracking-[0.11em] text-foreground-muted uppercase">
          <span
            class="size-[0.42rem] rounded-full bg-accent shadow-[0_0_0_0.25rem_color-mix(in_oklab,var(--accent)_12%,transparent)] [animation:status-pulse_2.5s_ease-in-out_infinite] motion-reduce:animate-none"
            aria-hidden="true"
          />
          <span>{status}</span>
        </div>
      )
    }

    <h2
      data-intro-item
      class="m-0 max-w-[58ch] text-[clamp(0.96rem,1vw,1.08rem)] leading-[1.75] text-foreground-secondary [&_strong]:font-semibold [&_strong]:text-foreground"
      set:html={convertAsteriskToStrongTag(presentation.description)}
    />

    <div data-intro-item>
      <SocialLinks />
    </div>
  </div>
</article>
