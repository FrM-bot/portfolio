---
import { skills } from '@/data/skills'
import { getI18n } from '@/i18n'

const { currentLocale } = Astro
const i18n = getI18n({ lang: currentLocale })
const title = i18n.Translations.sections.title.Skills
const skillTitles = i18n.Skills

const formatLabel = (label: string) => label.replace(/\.$/, '')

const rows = [
  { label: formatLabel(skillTitles.frontend.label), items: skills.frontend },
  { label: formatLabel(skillTitles.backendData.label), items: skills.backendData },
  { label: formatLabel(skillTitles.devops.label), items: skills.devops },
  { label: formatLabel(skillTitles.cloudServices.label), items: skills.cloudServices },
]
---

<article class="flex flex-col gap-[clamp(1.4rem,2.6vw,2.25rem)]">
  <header class="flex flex-col gap-[0.85rem]">
    <span data-section-label class="flex items-center gap-[0.7rem] font-display text-[0.7rem] leading-[1.3] font-semibold tracking-[0.16em] text-foreground-muted uppercase before:text-[0.8rem] before:text-accent before:content-['✦']">
      {title}
    </span>
  </header>

  <dl class="m-0 flex flex-col">
    {
      rows.map(({ label, items }) => (
        <div
          data-stagger-item
          class="grid grid-cols-1 gap-[0.6rem] border-t border-line py-[0.9rem] tablet:grid-cols-[minmax(6.5rem,0.7fr)_minmax(0,1.3fr)] tablet:items-start tablet:gap-4 last:border-b"
        >
          <dt class="font-display text-[0.64rem] font-semibold tracking-[0.13em] text-foreground-faint uppercase">
            {label}
          </dt>
          <dd class="m-0 flex flex-wrap gap-x-[0.8rem] gap-y-[0.35rem] text-[0.82rem] leading-[1.6] text-foreground-secondary">
            {items.map((skill) => (
              <span>
                {skill}
              </span>
            ))}
          </dd>
        </div>
      ))
    }
  </dl>
</article>
