---
import { getI18n } from '@/i18n'
import { formatDate } from '@/utils'

const { currentLocale } = Astro
const i18n = getI18n({ lang: currentLocale })
const experience = i18n.Experience
const presentLabel = i18n.Translations.words.present
const title = i18n.Translations.sections.title.Experience

const formatWork = (work: string[]) =>
  work.join(' · ').replace(/\s*\|\s*/g, ' · ')
---

<article class="flex flex-col gap-[clamp(1.4rem,2.6vw,2.25rem)]">
  <header class="flex flex-col gap-[0.85rem]">
    <span data-section-label class="flex items-center gap-[0.7rem] font-display text-[0.7rem] leading-[1.3] font-semibold tracking-[0.16em] text-foreground-muted uppercase before:text-[0.8rem] before:text-accent before:content-['✦']">
      {title}
    </span>
    <span data-section-line class="block h-px w-full origin-left bg-line"></span>
  </header>

  <ol class="m-0 flex list-none flex-col p-0">
    {
      experience.map(({ position, company, location, date, work }, i) => (
        <li data-stagger-item class="grid grid-cols-[2.5rem_minmax(0,1fr)] gap-4 border-t border-line py-5 transition-colors duration-200 last:pb-0">
          <div class="font-editorial text-[1.05rem] text-accent italic tabular-nums" aria-hidden="true">
            <span>
              {String(i + 1).padStart(2, '0')}
            </span>
          </div>

          <div class="flex min-w-0 flex-col gap-[0.55rem]">
            <div class="flex flex-col justify-between gap-[0.35rem] phone:flex-row phone:items-start phone:gap-4">
              <div>
                <p class="m-0 font-display text-[0.68rem] font-semibold tracking-[0.12em] text-foreground-faint uppercase">
                  {position}
                </p>
                <h3 class="mt-[0.2rem] mb-0 font-display text-[clamp(1.2rem,2vw,1.55rem)] leading-[1.1] font-semibold tracking-[-0.035em] text-foreground">
                  {company}
                </h3>
              </div>

              <span class="shrink-0 font-editorial text-[0.86rem] text-foreground-muted italic tabular-nums">
                {formatDate(new Date(date.from), { locales: currentLocale })} —{' '}
                {date?.to
                  ? formatDate(new Date(date.to), { locales: currentLocale })
                  : presentLabel}
              </span>
            </div>

            <p class="m-0 flex flex-wrap gap-x-[0.85rem] gap-y-[0.3rem] text-[0.88rem] leading-[1.7] text-foreground-muted">
              <span class="text-foreground-secondary">{location.country}</span>
              {work.length > 0 && (
                <span class="max-w-[62ch] text-foreground-faint">
                  {formatWork(work)}
                </span>
              )}
            </p>
          </div>
        </li>
      ))
    }
  </ol>
</article>
