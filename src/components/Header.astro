---
import Link from './ui/Link.astro'
import Moon from './icons/Moon.astro'
import Sun from './icons/Sun.astro'
import { Languages, getI18n } from '@/i18n'

const { currentLocale } = Astro

const NavigationLinks = [
  {
    label: Languages.ENGLISH,
    href: '/',
  },
  {
    label: Languages.SPANISH,
    href: `/${Languages.SPANISH}`,
  },
]

const i18n = getI18n({ lang: currentLocale })

const presentation = i18n.Presentation
---

<header class="flex w-full items-center justify-between gap-3">
  <Link target="_blank" variant="text" href={`mailto:${presentation.mail}`}
    >{presentation.mail}</Link
  >
  <div class="flex items-center gap-[clamp(0.65rem,3vw,2.25rem)]">
    <nav>
      <ul role="list" class="m-0 flex flex-row items-center gap-[0.85rem] p-0 max-[420px]:gap-[0.55rem]">
        {
          NavigationLinks.map((lang) => {
            const isCurrent = lang.label === currentLocale
            return (
              <li>
                <a
                  href={lang.href}
                  aria-current={isCurrent ? 'page' : undefined}
                  class={`font-display text-[0.68rem] font-semibold tracking-[0.12em] text-current no-underline uppercase transition-colors duration-[180ms] max-[420px]:text-[0.61rem] ${
                    isCurrent
                      ? 'text-foreground'
                      : 'text-foreground-faint hover:text-foreground-muted'
                  }`}
                >
                  {lang.label.toLocaleUpperCase()}
                </a>
              </li>
            )
          })
        }
      </ul>
    </nav>
    <button
      class="inline-grid size-[2.4rem] place-items-center rounded-full border border-line bg-transparent text-foreground-secondary transition-[color,border-color,background-color] duration-[180ms] hover:border-line-strong hover:bg-surface-raised hover:text-accent"
      id="theme-toggle"
      type="button"
      aria-label="Switch to light theme"
    >
      <span class="theme-icon-moon hidden" aria-hidden="true">
        <Moon width={18} height={18} />
      </span>
      <span class="theme-icon-sun" aria-hidden="true">
        <Sun width={18} height={18} />
      </span>
    </button>
  </div>
</header>

<script>
  const toggle = document.getElementById('theme-toggle')
  const moon = toggle?.querySelector('.theme-icon-moon')
  const sun = toggle?.querySelector('.theme-icon-sun')

  const apply = (theme: string) => {
    document.documentElement.setAttribute('data-theme', theme)
    localStorage.setItem('theme', theme)
    const isDark = theme === 'dark'
    moon?.classList.toggle('hidden', isDark)
    sun?.classList.toggle('hidden', !isDark)
    toggle?.setAttribute(
      'aria-label',
      isDark ? 'Switch to light theme' : 'Switch to dark theme',
    )
  }

  apply(document.documentElement.getAttribute('data-theme') || 'dark')

  toggle?.addEventListener('click', () => {
    const current =
      document.documentElement.getAttribute('data-theme') || 'dark'
    apply(current === 'dark' ? 'light' : 'dark')
  })
</script>
