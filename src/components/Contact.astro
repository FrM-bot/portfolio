---
import { getI18n } from '@/i18n'
import SocialLinks from './SocialLinks.astro'

const { currentLocale } = Astro
const i18n = getI18n({ lang: currentLocale })
const contact = i18n.Contact
const title = i18n.Translations.sections.title.Contact
---

<section class="flex flex-col gap-[clamp(1.4rem,2.6vw,2.25rem)]">
  <header class="flex flex-col gap-[0.85rem]">
    <span data-section-label class="flex items-center gap-[0.7rem] font-display text-[0.7rem] leading-[1.3] font-semibold tracking-[0.16em] text-foreground-muted uppercase before:text-[0.8rem] before:text-accent before:content-['✦']">
      {title}
    </span>
    <span class="block h-px w-full bg-line"></span>
  </header>

  <div class="grid grid-cols-1 items-end gap-5 phone:grid-cols-[minmax(0,1fr)_auto] phone:gap-8">
    <address
      data-stagger-item
      class="m-0 max-w-[60ch] font-editorial text-[clamp(1.5rem,3.2vw,2.6rem)] leading-[1.25] text-foreground-secondary italic"
      set:html={contact.message}
    />
    <div data-stagger-item>
      <SocialLinks />
    </div>
  </div>
</section>
