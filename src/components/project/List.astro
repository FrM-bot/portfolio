---
import ProjectCard from '@/components/card/Project.astro'
import ExternalTiny from '@/components/icons/ExternalTiny.astro'
import { getI18n } from '@/i18n'

const { currentLocale } = Astro
const i18n = getI18n({ lang: currentLocale })
const projects = i18n.Projects
const title = i18n.Translations.sections.title.Projects
const links = i18n.Translations.links

const featured = projects.filter((p) => p.highlight)
const regular = projects.filter((p) => !p.highlight)

const formatTechs = (values: string[], max = 3) =>
  values.slice(0, max).join(' · ') + (values.length > max ? ' …' : '')
---

<article class="flex flex-col gap-[clamp(1.4rem,2.6vw,2.25rem)]">
  <header class="flex flex-col gap-[0.85rem]">
    <span data-section-label class="flex items-center gap-[0.7rem] font-display text-[0.7rem] leading-[1.3] font-semibold tracking-[0.16em] text-foreground-muted uppercase before:text-[0.8rem] before:text-accent before:content-['✦']">
      {title}
    </span>
    <span data-section-line class="block h-px w-full origin-left bg-line"></span>
  </header>

  {
    featured.length > 0 && (
      <div class="grid grid-cols-1 gap-[0.85rem] phone:grid-cols-2 wide:grid-cols-3">
        {featured.map((project) => (
          <ProjectCard {...project} />
        ))}
      </div>
    )
  }

  {
    regular.length > 0 && (
      <div class="mt-4 flex flex-col">
        {regular.map((project, i) => (
          <div data-stagger-item class="grid grid-cols-[1.5rem_minmax(0,1fr)_auto] items-center gap-[0.45rem] border-t border-line px-[0.15rem] py-[0.9rem] phone:grid-cols-[2rem_minmax(0,1fr)_auto] phone:gap-3 tablet:grid-cols-[2rem_minmax(0,1fr)_minmax(0,1fr)_auto] tablet:gap-3 last:border-b">
            <span class="font-editorial text-[0.85rem] text-accent italic">
              {String(i + 1).padStart(2, '0')}
            </span>
            {project.link ? (
              <a
                href={project.link}
                target="_blank"
                rel="noopener noreferrer"
                class="overflow-hidden text-ellipsis text-[0.88rem] font-semibold whitespace-nowrap text-foreground no-underline transition-colors hover:text-accent"
              >
                {project.title}
              </a>
            ) : (
              <span class="overflow-hidden text-ellipsis text-[0.88rem] font-semibold whitespace-nowrap text-foreground">
                {project.title}
              </span>
            )}
            <span class="hidden overflow-hidden text-ellipsis text-[0.65rem] tracking-[0.07em] whitespace-nowrap text-foreground-faint uppercase tablet:block">
              {formatTechs(project.techs)}
            </span>
            <div class="flex items-center gap-2">
              {project.github && (
                <a
                  href={project.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group inline-flex items-center gap-1 rounded-full border border-line bg-surface px-2.5 py-[0.2rem] text-[0.75rem] font-medium tracking-[0.035em] whitespace-nowrap text-foreground-secondary no-underline transition duration-200 hover:border-line-strong hover:bg-surface-raised hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent/50"
                  aria-label={`${links.openOnGithubAria}: ${project.title}`}
                >
                  <span>GH</span>
                  <ExternalTiny class="transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 motion-reduce:transition-none" />
                </a>
              )}
              {project.link && (
                <a
                  href={project.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group inline-flex items-center gap-1 rounded-full border border-[var(--border)] bg-[var(--bg-subtle)] px-2.5 py-[0.2rem] text-[0.75rem] font-medium tracking-[0.035em] whitespace-nowrap text-[var(--text-secondary)] no-underline transition duration-200 hover:border-[color-mix(in_oklab,var(--border-strong)_76%,transparent)] hover:bg-[color-mix(in_oklab,var(--border)_88%,transparent)] hover:text-[var(--text)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[oklch(0.55_0.14_258/0.42)]"
                  aria-label={`${links.visitProjectAria}: ${project.title}`}
                >
                  <span>{links.visit}</span>
                  <ExternalTiny class="transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 motion-reduce:transition-none" />
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    )
  }
</article>
