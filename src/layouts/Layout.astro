---
import '@/styles/fonts.css'
import '@/styles/global.css'

import type { HeadTags } from '@/types'
export interface Props extends HeadTags {}

import Header from '@/components/Header.astro'
import SEOTags from '@/components/seo/SEOTags.astro'

const headTags = Astro.props as Props
---

<html lang="en" data-theme="dark" class="scroll-smooth bg-canvas">
  <SEOTags {...headTags} />

  <body class="min-w-80 bg-canvas font-body text-base leading-[1.55] text-foreground antialiased [font-kerning:normal] [font-feature-settings:'liga'_1,'kern'_1] [transition:background-color_300ms_ease,color_300ms_ease]">
    <div data-intro-header data-header-shell class="sticky top-0 z-40 w-full border-b border-transparent bg-canvas/86 py-4 backdrop-blur-[14px] transition-[border-color,background-color] duration-200">
      <div class="mx-auto flex w-full max-w-content items-center justify-between gap-4 px-3 sm:px-6 md:px-8">
        <Header />
      </div>
    </div>

    <div class="mx-auto w-full max-w-content px-4 pt-6 pb-10 sm:px-6 md:px-8 md:pt-9 md:pb-16">
      <slot />
    </div>

    <script>
      import { gsap } from 'gsap'
      import { ScrollTrigger } from 'gsap/ScrollTrigger'

      gsap.registerPlugin(ScrollTrigger)
      const motion = gsap.matchMedia()

      motion.add('(prefers-reduced-motion: no-preference)', () => {
        const context = gsap.context(() => {
          const intro = gsap.timeline({
            defaults: { duration: 0.62, ease: 'power3.out' },
          })

          intro
            .from('[data-intro-header]', { y: -12, autoAlpha: 0, duration: 0.46 })
            .from('[data-intro-item]', { y: 18, autoAlpha: 0, stagger: 0.075 }, '-=0.14')
            .from('[data-intro-title]', { yPercent: 110, duration: 0.78, ease: 'power4.out' }, '-=0.42')

          document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((section) => {
            const label = section.querySelector<HTMLElement>('[data-section-label]')
            const divider = section.querySelector<HTMLElement>('[data-section-line]')
            const items = section.querySelectorAll<HTMLElement>('[data-stagger-item]')
            const animateSection = () => {
              requestAnimationFrame(() =>
                context.add(() => {
                  const reveal = gsap.timeline({
                    defaults: { ease: 'power3.out' },
                  })

                  if (label) reveal.fromTo(label, { x: -14, autoAlpha: 0 }, { x: 0, autoAlpha: 1, duration: 0.5 })
                  if (divider) {
                    reveal.fromTo(divider, { scaleX: 0 }, { scaleX: 1, transformOrigin: 'left center', duration: 0.62 }, '<0.05')
                  }
                  if (items.length) {
                    reveal.fromTo(items, { y: 16, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: 0.46, stagger: 0.085 }, '-=0.08')
                  }
                }),
              )
            }

            ScrollTrigger.create({
              trigger: section,
              start: 'top 86%',
              once: true,
              onEnter: animateSection,
            })
          })
        }, document.body)

        return () => context.revert()
      })

      window.addEventListener('pagehide', () => motion.revert(), { once: true })

      const headerShell = document.querySelector('[data-header-shell]')
      const onScroll = () => {
        const isScrolled = window.scrollY > 20
        headerShell?.classList.toggle('border-line', isScrolled)
        headerShell?.classList.toggle('bg-canvas/94', isScrolled)
        headerShell?.classList.toggle('border-transparent', !isScrolled)
        headerShell?.classList.toggle('bg-canvas/86', !isScrolled)
      }
      window.addEventListener('scroll', onScroll, { passive: true })
      onScroll()
    </script>
  </body>
</html>
