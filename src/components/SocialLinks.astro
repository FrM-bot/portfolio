---
import { getI18n } from '@/i18n'
import ExternalTiny from './icons/ExternalTiny.astro'

const { currentLocale } = Astro
const i18n = getI18n({ lang: currentLocale })
const { socials } = i18n.Presentation
---

<ul role="list" class="m-0 flex list-none flex-wrap gap-2 p-0">
  {
    socials.map((social) => (
      <li>
        <a
          href={social.link}
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex min-h-8 items-center gap-[0.45rem] rounded-full border border-line bg-transparent px-3 py-[0.35rem] font-display text-[0.65rem] font-semibold tracking-[0.1em] text-foreground-secondary no-underline uppercase transition-[color,border-color,background-color] duration-[180ms] hover:border-accent hover:bg-accent hover:text-accent-ink"
        >
          <span>{social.label}</span>
          <ExternalTiny class="transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 motion-reduce:transition-none" />
        </a>
      </li>
    ))
  }
</ul>
