---
import type { Project } from '@/data/projects'
import ExternalTiny from '@/components/icons/ExternalTiny.astro'

type Props = Project

const { title, techs, link, links, description } = Astro.props as Props
const TitleTag = link ? 'a' : 'span'

const formatTechs = (values: string[]) => values.join(' · ')
---

<article
  data-stagger-item
  class="flex min-h-64 min-w-0 flex-col justify-between gap-[1.4rem] rounded-card border border-line bg-surface p-[clamp(1rem,2vw,1.45rem)] transition-[border-color,background-color,transform] duration-[220ms] hover:-translate-y-[3px] hover:border-line-strong hover:bg-surface-raised max-[620px]:min-h-[13rem]"
>
  <div class="flex h-full flex-col justify-between gap-6">
    <div class="flex flex-col gap-[0.55rem]">
      <TitleTag
        href={link}
        target={link ? '_blank' : undefined}
        rel={link ? 'noopener noreferrer' : undefined}
        class:list={[
          'font-display text-[clamp(1.15rem,1.7vw,1.55rem)] leading-[1.05] font-semibold tracking-[-0.04em] text-foreground no-underline',
          link && 'transition-colors hover:text-accent'
        ]}
      >
        {title}
      </TitleTag>
      <p class="m-0 text-[0.66rem] leading-[1.6] font-semibold tracking-[0.08em] text-foreground-faint uppercase">
        {formatTechs(techs)}
      </p>
      {
        description && (
          <p class="mt-1 mb-0 text-[0.82rem] leading-[1.65] text-foreground-muted">
            {description}
          </p>
        )
      }
    </div>

    <div class="flex flex-wrap gap-[0.45rem]">
      {links.map(({ href, label }) => (
        <a
          href={href}
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex min-h-8 items-center gap-[0.35rem] rounded-full border border-line bg-transparent px-[0.7rem] py-[0.35rem] font-display text-[0.63rem] font-semibold tracking-[0.1em] text-foreground-secondary no-underline uppercase transition-[color,border-color,background-color] duration-[180ms] hover:border-accent hover:bg-accent hover:text-accent-ink"
          aria-label={`${label}: ${title}`}
        >
          <span>{label}</span>
          <ExternalTiny class="transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 motion-reduce:transition-none" />
        </a>
      ))}
    </div>
  </div>
</article>
