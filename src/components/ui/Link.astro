---
import { cn } from '@/utils'
import type { HTMLAttributes } from 'astro/types'

const TEXT_LINK_BASE =
  'relative inline-flex items-center font-display text-[0.75rem] font-medium tracking-[0.04em] text-foreground-muted no-underline transition-colors duration-200 after:absolute after:right-0 after:bottom-[-2px] after:left-0 after:h-px after:origin-left after:scale-x-0 after:bg-foreground/80 after:transition-transform after:duration-250 hover:text-foreground-secondary hover:after:scale-x-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent/45 active:text-foreground'

const VARIANTS = {
  default: TEXT_LINK_BASE,
  text: TEXT_LINK_BASE,
  gradient: TEXT_LINK_BASE,
  rounded:
    'inline-flex items-center rounded-full border border-line/86 bg-surface/80 px-4 py-1.5 text-[0.875rem] font-medium text-foreground-secondary no-underline shadow-[0_1px_0_color-mix(in_oklab,var(--bg)_22%,transparent)] transition duration-200 hover:border-line-strong/78 hover:bg-surface-raised hover:text-foreground active:translate-y-0 active:scale-[0.995] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent/45 motion-reduce:active:scale-100',
}

type Props = HTMLAttributes<'a'> & {
  variant?: keyof typeof VARIANTS
}

const { variant = 'default', ...props } = Astro.props as Props

const className = cn(VARIANTS[variant], props.class ?? '')
---

<a href={props.href} class={className} {...props}>
  <slot />
</a>
